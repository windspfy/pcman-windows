IDD_PTT_FILTER DIALOGEX 0, 0, 310, 229
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "PTT／PTT2 黑名單與關鍵字"
FONT 9, "Microsoft JhengHei UI"
BEGIN
 LTEXT "規則清單", -1, 8, 10, 48, 12
 COMBOBOX IDC_FILTER_KIND, 62, 8, 120, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LISTBOX IDC_FILTER_LIST, 8, 27, 294, 54, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
 LTEXT "比對文字", -1, 8, 88, 48, 12
 EDITTEXT IDC_FILTER_VALUE, 62, 85, 152, 15, ES_AUTOHSCROLL
 CONTROL "完全相同", IDC_FILTER_EXACT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 222, 87, 78, 12
 LTEXT "套用範圍", -1, 8, 107, 48, 12
 COMBOBOX IDC_FILTER_SCOPE, 62, 104, 92, 65, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "遮蔽方式", -1, 160, 107, 44, 12
 COMBOBOX IDC_FILTER_EFFECT, 206, 104, 96, 70, CBS_DROPDOWNLIST | WS_TABSTOP
 PUSHBUTTON "新增", IDC_FILTER_ADD, 62, 125, 54, 15
 PUSHBUTTON "更新", IDC_FILTER_UPDATE, 120, 125, 54, 15
 PUSHBUTTON "刪除", IDC_FILTER_REMOVE, 178, 125, 54, 15
 GROUPBOX "共用設定", -1, 8, 146, 294, 51
 LTEXT "預設遮蔽", -1, 15, 164, 50, 12
 COMBOBOX IDC_FILTER_DEFAULT, 65, 161, 64, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "字色", -1, 134, 164, 22, 12
 COMBOBOX IDC_FILTER_FG, 156, 161, 57, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "底色", -1, 220, 164, 22, 12
 COMBOBOX IDC_FILTER_BG, 242, 161, 55, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "確定", IDOK, 190, 205, 54, 16
 PUSHBUTTON "取消", IDCANCEL, 248, 205, 54, 16
END
