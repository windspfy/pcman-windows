IDD_PTT_FILTER DIALOGEX 0, 0, 380, 286
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "PTT／PTT2 名單與關鍵字"
FONT 9, "Microsoft JhengHei UI"
BEGIN
 EDITTEXT IDC_FILTER_SEARCH, 8, 8, 120, 14, ES_AUTOHSCROLL
 COMBOBOX IDC_FILTER_SHOW, 132, 8, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 RTEXT "", IDC_FILTER_COUNT, 210, 11, 162, 10
 CONTROL "", IDC_FILTER_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 27, 364, 102
 LTEXT "雙擊項目可編輯，按 Delete 可刪除（可多選）", -1, 8, 136, 220, 10
 PUSHBUTTON "編輯", IDC_FILTER_EDIT, 260, 133, 54, 15
 PUSHBUTTON "刪除", IDC_FILTER_REMOVE, 318, 133, 54, 15
 GROUPBOX "新增規則（填好後按 Enter 或「加入」）", -1, 8, 153, 364, 60
 COMBOBOX IDC_FILTER_KIND, 14, 167, 44, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 EDITTEXT IDC_FILTER_VALUE, 62, 166, 170, 14, ES_AUTOHSCROLL
 LTEXT "效果", -1, 240, 169, 18, 10
 COMBOBOX IDC_FILTER_EFFECT, 260, 167, 60, 70, CBS_DROPDOWNLIST | WS_TABSTOP
 PUSHBUTTON "加入", IDC_FILTER_ADD, 326, 166, 40, 15
 LTEXT "套用於", -1, 14, 186, 28, 10
 CONTROL "列表", IDC_FILTER_IN_LIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 185, 36, 12
 CONTROL "內文", IDC_FILTER_IN_BODY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 185, 36, 12
 CONTROL "推文", IDC_FILTER_IN_COMMENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 185, 36, 12
 LTEXT "內文遮罩", -1, 170, 186, 34, 10
 COMBOBOX IDC_FILTER_EXTENT, 206, 184, 60, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "", IDC_FILTER_ERROR, 14, 200, 352, 10
 GROUPBOX "共用設定", -1, 8, 218, 364, 40
 LTEXT "預設效果", -1, 14, 236, 34, 10
 COMBOBOX IDC_FILTER_DEFAULT, 50, 234, 52, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "標色字色", -1, 110, 236, 34, 10
 PUSHBUTTON "", IDC_FILTER_FG, 146, 232, 58, 16, BS_OWNERDRAW | WS_TABSTOP
 LTEXT "底色", -1, 210, 236, 18, 10
 PUSHBUTTON "", IDC_FILTER_BG, 228, 232, 58, 16, BS_OWNERDRAW | WS_TABSTOP
 CONTROL "", IDC_FILTER_PREVIEW, "Static", SS_OWNERDRAW, 292, 227, 74, 26
 DEFPUSHBUTTON "儲存", IDOK, 260, 265, 54, 16
 PUSHBUTTON "取消", IDCANCEL, 318, 265, 54, 16
END

IDD_PTT_FILTER_RULE DIALOGEX 0, 0, 220, 134
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "編輯規則"
FONT 9, "Microsoft JhengHei UI"
BEGIN
 LTEXT "類型", -1, 8, 10, 36, 10
 COMBOBOX IDC_FILTER_KIND, 48, 8, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "內容", -1, 8, 28, 36, 10
 EDITTEXT IDC_FILTER_VALUE, 48, 26, 164, 14, ES_AUTOHSCROLL
 LTEXT "套用於", -1, 8, 46, 36, 10
 CONTROL "列表", IDC_FILTER_IN_LIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 48, 45, 36, 12
 CONTROL "內文", IDC_FILTER_IN_BODY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 45, 36, 12
 CONTROL "推文", IDC_FILTER_IN_COMMENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 128, 45, 36, 12
 LTEXT "內文遮罩", -1, 8, 64, 36, 10
 COMBOBOX IDC_FILTER_EXTENT, 48, 62, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "效果", -1, 8, 82, 36, 10
 COMBOBOX IDC_FILTER_EFFECT, 48, 80, 70, 70, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "", IDC_FILTER_ERROR, 8, 99, 204, 10
 DEFPUSHBUTTON "確定", IDOK, 104, 113, 52, 15
 PUSHBUTTON "取消", IDCANCEL, 160, 113, 52, 15
END
